CONFIG_ENV=config.env
ARCH=arm64
KERNEL_SOURCE=https://github.com/xxx/your-wayne-kernel.git
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=wayne_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS=
CUSTOM_CMDS=
GCC_64=
GCC_32=
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=false

ENABLE_KERNELSU=true
KERNELSU_TAG=latest
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE-LTO=true
DISABLE_CC_WERROR=true
APPLY_KSU_PATCH=false

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

ENABLE_CCACHE=true
NEED_DTBO=false
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://xxx/original‑boot‑wayne.img

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
