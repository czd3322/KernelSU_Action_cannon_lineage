CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/LineageOS-wayne/android_kernel_xiaomi_wayne
KERNEL_SOURCE_BRANCH=lineage-20.0
KERNEL_CONFIG=vendor/wayne_defconfig
ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb
ENABLE_KERNELSU=true
SOURCE_BOOT_IMAGE=https://github.com/czd3322/wayne-files/raw/refs/heads/main/boot.img
BUILD_BOOT_IMG=true

# 使用自定义 Clang（从压缩包下载，而非 git）
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/18.1.8/clang-18.1.8.tar.gz

# 其他开关全部设为 false（保持默认）
APPLY_KSU_PATCH=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE-LTO=false
DISABLE_CC_WERROR=false
NEED_DTBO=false
ENABLE_CCACHE=false
USE_CUSTOM_ANYKERNEL3=false
ADD_LOCALVERSION_TO_FILENAME=false
