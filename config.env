CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=gauguin-r-oss
KERNEL_CONFIG=vendor/gauguin_defconfig
ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb
ADD_LOCALVERSION_TO_FILENAME=false
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86
CUSTOM_CLANG_BRANCH=master-kernel-build-2021
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

ENABLE_KERNELSU=true
KERNELSU_TAG=

DISABLE-LTO=true
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
APPLY_KERNELSU_PATCH=true

ENABLE_CCACHE=true
USE_CUSTOM_ANY_KERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
